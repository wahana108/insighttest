rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    // KA-1 (docs/arsitektur.md): selalu .get('field', default), TIDAK PERNAH
    // .data.field langsung — field yang belum ada membuat evaluasi error dan
    // menolak alih-alih dianggap null.
    function hasRole(r) {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userData(request.auth.uid).get('status', null) == 'aktif'
        && userData(request.auth.uid).get('role', null) == r;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('superadmin');
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function undanganPath(email) {
      return /databases/$(database)/documents/undangan/$(email);
    }

    // Mode pendaftaran dibaca dari parameter/global. KA-1 berlaku juga di
    // sini: default 'terbuka' kalau field belum diisi.
    function modePendaftaran() {
      return get(/databases/$(database)/documents/parameter/global)
        .data.get('modePendaftaran', 'terbuka');
    }

    // Undangan pendaftar saat ini (dari email token-nya) harus ada, dan role
    // yang diminta di profil baru harus sama dengan role di undangan itu.
    function roleSesuaiUndangan() {
      let email = request.auth.token.email;
      return exists(undanganPath(email))
        && get(undanganPath(email)).data.get('role', null)
          == request.resource.data.get('role', null);
    }

    function canCreateUserProfile(uid) {
      let mode = modePendaftaran();
      return request.resource.data.get('uid', null) == uid
        && (
          (
            mode == 'terbuka'
            && request.resource.data.get('role', null) == 'peserta'
            && request.resource.data.get('status', null) == 'aktif'
          ) || (
            mode == 'persetujuan'
            && request.resource.data.get('role', null) == 'peserta'
            && request.resource.data.get('status', null) == 'pending'
          ) || (
            mode == 'undangan'
            && request.resource.data.get('status', null) == 'aktif'
            && roleSesuaiUndangan()
          )
        );
    }

    // KA-2: satu-satunya penulis yang sah adalah createProfileForNewAccount()
    // di client (src/lib/auth/user-profile.ts) — rule create di bawah adalah
    // penjaganya di sisi server.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Pemilik hanya boleh membuat dokumen dirinya sendiri, dengan role dan
      // status yang sesuai mode pendaftaran saat ini — tidak bisa self-elevate.
      // Lihat canCreateUserProfile() untuk tiga jalur mode terbuka /
      // persetujuan / undangan.
      allow create: if isOwner(uid) && canCreateUserProfile(uid);

      // Pemilik: profil tampilan + data formulir sertifikat (§11) — TIDAK
      // PERNAH role/status (KA-7). Admin: hanya status. Superadmin: role
      // dan/atau status. Tidak ada jalur yang mencampur milik pemilik dengan
      // milik admin/superadmin dalam satu update.
      allow update: if (
          isOwner(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'displayName', 'photoURL', 'namaLengkap', 'institusi',
              'nomorIdentitas', 'noTelepon', 'updatedAt'
            ])
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'updatedAt'])
        ) || (
          isSuperAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['role', 'status', 'updatedAt'])
        );

      allow delete: if false;
    }

    // undangan/{email}: id dokumen = email ternormalisasi (trim + lowercase),
    // lihat normalizeEmail() di src/lib/services/user-invitation.ts. ID
    // deterministik ini yang membuat exists()/get() di atas bisa dilakukan
    // tanpa query (KA-3, docs/arsitektur.md).
    match /undangan/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == email);

      allow create: if isAdmin();
      allow delete: if isAdmin();

      // Hanya pengguna yang diundang, hanya mengisi usedAt+usedBy, dan hanya
      // kalau usedAt saat ini masih kosong. PERINGATAN (KA-1): pakai
      // .get('usedAt', null), JANGAN PERNAH .data.usedAt — dokumen tanpa
      // field usedAt bukan null, ia membuat evaluasi error dan menolak.
      // Insiden nyata di TNA persis pada field ini membuat pendaftaran
      // tertutup gagal total dan akun ter-rollback.
      allow update: if isSignedIn()
        && request.auth.token.email == email
        && resource.data.get('usedAt', null) == null
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['usedAt', 'usedBy'])
        && request.resource.data.get('usedBy', null) == request.auth.uid;
    }

    // topik/{kode}: id dokumen = kode topik ternormalisasi (trim, huruf
    // besar, A-Z/0-9/tanda hubung), lihat normalizeKode() di
    // src/lib/services/topik.ts. ID deterministik ini mencegah kode ganda
    // by construction (KA-3, docs/arsitektur.md). Tidak ada hapus permanen —
    // topik yang dihapus meninggalkan soal yatim di bank soal (KA-6).
    match /topik/{kode} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // soal/{id}: bank soal, id dokumen auto (bukan deterministik — bank soal
    // tidak terikat kegiatan, kegiatan hanya merujuk id-nya, KA-6). Opsi di
    // sini TIDAK PERNAH membawa penanda benar/salah, lihat kunci_soal di
    // bawah. Peserta tidak pernah membaca koleksi ini langsung — di tahap 3
    // soal dikirim ke peserta lewat Route Handler yang menyaring kunci.
    // Tidak ada hapus permanen, hanya isActive.
    match /soal/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // kunci_soal/{soalId}: id dokumen = id dokumen soal (deterministik,
    // lihat buildSoalWrite() di src/lib/services/soal.ts) — pasangan 1:1
    // dengan soal/{id}. Kunci jawaban tidak pernah turun ke peserta atau
    // panitia dalam bentuk apa pun; hanya admin/superadmin yang mengelola
    // bank soal boleh membaca atau menulisnya (KA-3, docs/arsitektur.md).
    match /kunci_soal/{soalId} {
      allow read, write: if isAdmin();
    }

    // kegiatan/{id}: satu gelombang = satu dokumen (§4, docs/arsitektur.md).
    // Peserta hanya boleh membaca kegiatan yang sudah diterbitkan; admin
    // boleh melihat draf juga supaya bisa menyunting sebelum menerbitkan.
    // Tidak ada hapus permanen — pakai isArchived.
    match /kegiatan/{id} {
      allow read: if isSignedIn() && (resource.data.get('isPublished', false) == true || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;

      // kegiatan/{id}/modul/{mid}: kategori referensi | atestasi | evaluasi
      // (§2). Bank soal tidak disalin ke sini — modul evaluasi hanya
      // menyimpan rujukan (soalIds atau topikKode+jumlah), KA-6.
      match /modul/{mid} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // pendaftaran/{kegiatanId}_{uid}: id deterministik (KA-3), ditulis
    // HANYA oleh server lewat Admin SDK (POST /api/pendaftaran) — nomor
    // urut dan modulSnapshot harus dijamin konsisten dalam satu transaksi,
    // dan modulSnapshot tidak boleh berubah lagi setelah dibuat (KA-5).
    // Klien tidak pernah menulis apa pun di sini, tanpa kecuali.
    match /pendaftaran/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', null) == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // attempt/{id}: id dokumen auto, ditulis HANYA oleh server lewat Admin
    // SDK (POST /api/attempt, POST /api/attempt/[id]/submit). Penilaian
    // memakai kunci_soal yang hanya bisa dibaca Admin SDK (KA-3), dan
    // jendela waktu diperiksa di server, bukan di penghitung mundur browser
    // — klien tidak pernah menulis attempt sama sekali.
    match /attempt/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', null) == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // sertifikat/{kegiatanId}_{uid}: id deterministik (KA-3), ditulis HANYA
    // oleh server lewat Admin SDK (POST /api/sertifikat/terbitkan). Serial
    // dan kodeVerifikasi tidak boleh dipalsukan atau ditimpa klien —
    // klien tidak pernah menulis sertifikat sama sekali.
    match /sertifikat/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', null) == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // parameter/global dibaca siapa pun, termasuk yang belum login — isinya
    // murni teks tampilan (nama platform, mode pendaftaran, pesan beranda).
    // PERINGATAN: dokumen ini terbuka dibaca tanpa syarat apa pun. JANGAN
    // PERNAH menaruh field sensitif (kredensial, kunci, data pribadi) di
    // sini — apa pun yang ditulis ke dokumen ini otomatis publik.
    match /parameter/global {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
