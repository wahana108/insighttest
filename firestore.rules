rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    // KA-1 (docs/arsitektur.md): selalu .get('field', default), TIDAK PERNAH
    // .data.field langsung — field yang belum ada membuat evaluasi error dan
    // menolak alih-alih dianggap null.
    function hasRole(r) {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && userData(request.auth.uid).get('status', null) == 'aktif'
        && userData(request.auth.uid).get('role', null) == r;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('superadmin');
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    // Slice 8.1 (docs/kickoff.md): panitia ditugaskan PER KEGIATAN lewat
    // panitiaUids + panitiaIzin pada kegiatan/{id} itu sendiri — bukan role
    // global seperti isAdmin(). Ini REIMPLEMENTASI izinPanitia()
    // (src/lib/izin-panitia.ts) di bahasa Rules, karena Rules tidak bisa
    // memanggil TS: kalau salah satu berubah, ubah yang lain. Dipakai lewat
    // `resource.data` (pemeriksaan pada dokumen kegiatan yang SEDANG
    // dibaca/ditulis) untuk match /kegiatan/{id} sendiri, dan lewat get()
    // eksplisit untuk match /kegiatan/{id}/modul/{mid} yang butuh data
    // kegiatan induknya.
    function panitiaBolehSuntingData(kegiatanData) {
      return isSignedIn()
        && hasRole('panitia')
        && request.auth.uid in kegiatanData.get('panitiaUids', [])
        && kegiatanData.get('panitiaIzin', {})
          .get(request.auth.uid, {})
          .get('suntingKegiatan', false) == true;
    }

    function panitiaDitugaskanData(kegiatanData) {
      return isSignedIn()
        && hasRole('panitia')
        && request.auth.uid in kegiatanData.get('panitiaUids', []);
    }

    // Slice 8.1a: DAFTAR IZIN untuk field kegiatan/{id} yang boleh disentuh
    // panitia lewat suntingKegiatan — "yang berkaitan dengan penyelenggaraan"
    // (docs/kickoff.md): judul, deskripsi, jendela waktu, syarat sertifikat
    // (beserta ambang dan centang prasyaratnya — satu field map, ditulis
    // sebagai satu kesatuan oleh updateKegiatan()), dan template sertifikat.
    // updatedAt/updatedBy ikut karena updateKegiatan() SELALU menulis
    // keduanya bersama field lain. TIDAK PERNAH menambah kode, isPublished,
    // isArchived, nomorUrutTerakhir, panitiaUids, atau panitiaIzin di sini —
    // itu justru maksudnya: apa pun yang tidak disebut secara eksplisit di
    // daftar ini tertolak oleh hasOnly() di allow update, termasuk field
    // yang belum ada hari ini.
    function panitiaKegiatanKunciDiizinkan() {
      return [
        'judul', 'deskripsi', 'dibukaPada', 'ditutupPada',
        'syaratSertifikat', 'templateSertifikat',
        'updatedAt', 'updatedBy'
      ];
    }

    // Slice 8.2 (docs/kickoff.md): kewenangan membuat/menyunting soal GLOBAL
    // (users/{uid}.bolehBuatSoal) — bukan per kegiatan seperti
    // panitiaBolehSuntingData() di atas, karena bank soal tidak terikat
    // kegiatan mana pun (KA-6). REIMPLEMENTASI izinSoal()/bolehSuntingSoal()
    // (src/lib/izin-soal.ts) di bahasa Rules — kalau salah satu berubah,
    // ubah yang lain.
    function bolehBuatSoalUser(uid) {
      return exists(userPath(uid)) && userData(uid).get('bolehBuatSoal', false) == true;
    }

    // `data` adalah resource.data (dokumen yang sudah ada) ATAU
    // request.resource.data (payload yang sedang ditulis) — keduanya map
    // biasa dengan .get(), jadi satu fungsi ini dipakai untuk create
    // (memeriksa payload) maupun read/update (memeriksa dokumen tersimpan).
    //
    // PENTING — kenapa ini TIDAK PERNAH memakai get() ke koleksi 'soal'
    // dari dalam match /kunci_soal/{soalId}: soal/{id} dan kunci_soal/{id}
    // SELALU ditulis bersamaan dalam satu writeBatch (buildSoalWrite(),
    // src/lib/services/soal.ts). Diverifikasi lewat emulator (Slice 8.2)
    // bahwa get() ke dokumen LAIN yang ikut ditulis dalam writeBatch yang
    // SAMA gagal — bukan cuma untuk dokumen baru, tapi juga untuk dokumen
    // yang sudah ada sebelumnya dan ditulis ulang bersamaan. Kalau rule
    // kunci_soal memakai get(/soal/$(soalId)), maka SETIAP tulisan
    // kunci_soal (baik create maupun update, karena buildSoalWrite()
    // selalu menulis ulang keduanya) akan selalu ditolak. Karena itu
    // dibuatOleh DISALIN ke dokumen kunci_soal itu sendiri saat ditulis —
    // fungsi ini memeriksa field pada dokumennya SENDIRI, tidak pernah
    // lintas dokumen.
    function panitiaPemilikData(data) {
      return isSignedIn()
        && hasRole('panitia')
        && bolehBuatSoalUser(request.auth.uid)
        && data.get('dibuatOleh', '') == request.auth.uid;
    }

    function undanganPath(email) {
      return /databases/$(database)/documents/undangan/$(email);
    }

    // Mode pendaftaran dibaca dari parameter/global. KA-1 berlaku juga di
    // sini: default 'terbuka' kalau field belum diisi.
    function modePendaftaran() {
      return get(/databases/$(database)/documents/parameter/global)
        .data.get('modePendaftaran', 'terbuka');
    }

    // Undangan pendaftar saat ini (dari email token-nya) harus ada, dan role
    // yang diminta di profil baru harus sama dengan role di undangan itu.
    function roleSesuaiUndangan() {
      let email = request.auth.token.email;
      return exists(undanganPath(email))
        && get(undanganPath(email)).data.get('role', null)
          == request.resource.data.get('role', null);
    }

    function canCreateUserProfile(uid) {
      let mode = modePendaftaran();
      return request.resource.data.get('uid', null) == uid
        && (
          (
            mode == 'terbuka'
            && request.resource.data.get('role', null) == 'peserta'
            && request.resource.data.get('status', null) == 'aktif'
          ) || (
            mode == 'persetujuan'
            && request.resource.data.get('role', null) == 'peserta'
            && request.resource.data.get('status', null) == 'pending'
          ) || (
            mode == 'undangan'
            && request.resource.data.get('status', null) == 'aktif'
            && roleSesuaiUndangan()
          )
        );
    }

    // KA-2: satu-satunya penulis yang sah adalah createProfileForNewAccount()
    // di client (src/lib/auth/user-profile.ts) — rule create di bawah adalah
    // penjaganya di sisi server.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Pemilik hanya boleh membuat dokumen dirinya sendiri, dengan role dan
      // status yang sesuai mode pendaftaran saat ini — tidak bisa self-elevate.
      // Lihat canCreateUserProfile() untuk tiga jalur mode terbuka /
      // persetujuan / undangan.
      allow create: if isOwner(uid) && canCreateUserProfile(uid);

      // Pemilik: profil tampilan + data formulir sertifikat (§11) — TIDAK
      // PERNAH role/status/bolehBuatSoal (KA-7). Admin: status DAN
      // bolehBuatSoal (Slice 8.2 — kewenangan bank soal global, diberikan
      // admin/superadmin, lihat src/lib/izin-soal.ts). Superadmin: role
      // dan/atau status. Tidak ada jalur yang mencampur milik pemilik dengan
      // milik admin/superadmin dalam satu update.
      allow update: if (
          isOwner(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'displayName', 'photoURL', 'namaLengkap', 'institusi',
              'nomorIdentitas', 'noTelepon', 'updatedAt'
            ])
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'bolehBuatSoal', 'updatedAt'])
        ) || (
          isSuperAdmin()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['role', 'status', 'updatedAt'])
        );

      allow delete: if false;
    }

    // undangan/{email}: id dokumen = email ternormalisasi (trim + lowercase),
    // lihat normalizeEmail() di src/lib/services/user-invitation.ts. ID
    // deterministik ini yang membuat exists()/get() di atas bisa dilakukan
    // tanpa query (KA-3, docs/arsitektur.md).
    match /undangan/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == email);

      allow create: if isAdmin();
      allow delete: if isAdmin();

      // Hanya pengguna yang diundang, hanya mengisi usedAt+usedBy, dan hanya
      // kalau usedAt saat ini masih kosong. PERINGATAN (KA-1): pakai
      // .get('usedAt', null), JANGAN PERNAH .data.usedAt — dokumen tanpa
      // field usedAt bukan null, ia membuat evaluasi error dan menolak.
      // Insiden nyata di TNA persis pada field ini membuat pendaftaran
      // tertutup gagal total dan akun ter-rollback.
      allow update: if isSignedIn()
        && request.auth.token.email == email
        && resource.data.get('usedAt', null) == null
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['usedAt', 'usedBy'])
        && request.resource.data.get('usedBy', null) == request.auth.uid;
    }

    // topik/{kode}: id dokumen = kode topik ternormalisasi (trim, huruf
    // besar, A-Z/0-9/tanda hubung), lihat normalizeKode() di
    // src/lib/services/topik.ts. ID deterministik ini mencegah kode ganda
    // by construction (KA-3, docs/arsitektur.md). Tidak ada hapus permanen —
    // topik yang dihapus meninggalkan soal yatim di bank soal (KA-6). BACA
    // sudah terbuka untuk SIAPA PUN yang masuk sejak awal (bukan cuma
    // admin) — diperiksa ulang di Slice 8.1b, tidak diubah, hanya soal/{id}
    // di bawah yang memang tertutup.
    match /topik/{kode} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // soal/{id}: bank soal, id dokumen auto (bukan deterministik — bank soal
    // tidak terikat kegiatan, kegiatan hanya merujuk id-nya, KA-6). Opsi di
    // sini TIDAK PERNAH membawa penanda benar/salah, lihat kunci_soal di
    // bawah — itu pemisahan yang membuat Slice 8.1b/8.2 aman: panitia BACA
    // seluruh bank soal (pertanyaan + pilihan, perlu menyusun modul evaluasi
    // lewat src/lib/services/modul.ts) tapi TIDAK PERNAH kunci_soal
    // (jawaban). Peserta tetap tidak pernah membaca koleksi ini langsung —
    // di tahap 3 soal dikirim ke peserta lewat Route Handler yang menyaring
    // kunci.
    //
    // Slice 8.2: MENULIS sekarang berbasis KEPEMILIKAN, bukan cuma peran —
    // panitia dengan users/{uid}.bolehBuatSoal boleh membuat soal baru
    // (dengan dibuatOleh == dirinya sendiri) dan menyunting HANYA soal yang
    // dibuatOleh dirinya. Soal lama tanpa field dibuatOleh sama sekali
    // (default '' lewat KA-1) tidak pernah cocok dengan uid siapa pun —
    // diperlakukan sebagai milik admin, cuma admin yang bisa menyuntingnya.
    // Baris kedua allow update memastikan dibuatOleh TIDAK BISA dialihkan —
    // pemiliknya tetap, siapa pun yang menyunting field lain. Tidak ada
    // hapus permanen, hanya isActive.
    match /soal/{id} {
      allow read: if isAdmin() || hasRole('panitia');
      allow create: if isAdmin() || panitiaPemilikData(request.resource.data);
      allow update: if isAdmin() || (
        panitiaPemilikData(resource.data)
        && request.resource.data.get('dibuatOleh', '') == resource.data.get('dibuatOleh', '')
      );
      allow delete: if false;
    }

    // kunci_soal/{soalId}: id dokumen = id dokumen soal (deterministik,
    // lihat buildSoalWrite() di src/lib/services/soal.ts) — pasangan 1:1
    // dengan soal/{id}, SELALU ditulis bersamaan dalam satu writeBatch.
    // Kunci jawaban tidak pernah turun ke peserta dalam bentuk apa pun.
    //
    // Slice 8.2: panitia pemilik soal yang bersangkutan (dibuatOleh ==
    // dirinya, DISALIN ke dokumen kunci_soal ini sendiri — lihat komentar
    // panjang di panitiaPemilikData() di atas untuk alasannya: get() ke
    // soal/{id} dari sini tidak bisa dipakai) boleh membaca/menulis
    // kunci_soal miliknya sendiri. Baris kedua allow update mencegah
    // dibuatOleh dialihkan, sama seperti soal/{id} di atas.
    match /kunci_soal/{soalId} {
      allow read: if isAdmin() || panitiaPemilikData(resource.data);
      allow create: if isAdmin() || panitiaPemilikData(request.resource.data);
      allow update: if isAdmin() || (
        panitiaPemilikData(resource.data)
        && request.resource.data.get('dibuatOleh', '') == resource.data.get('dibuatOleh', '')
      );
      allow delete: if false;
    }

    // kegiatan/{id}: satu gelombang = satu dokumen (§4, docs/arsitektur.md).
    // Peserta hanya boleh membaca kegiatan yang sudah diterbitkan; admin
    // boleh melihat draf juga supaya bisa menyunting sebelum menerbitkan;
    // sejak Slice 8.1, panitia yang ditugaskan juga boleh membaca kegiatan
    // ini walau belum terbit (lihat panitiaDitugaskanData() di atas) — READ
    // ini provable untuk query list ber-where('panitiaUids','array-contains',
    // uid), sama seperti pola where('isPublished','==',true) untuk peserta
    // (lihat komentar di src/lib/hooks/use-kegiatan-list.ts). Tidak ada
    // hapus permanen — pakai isArchived.
    match /kegiatan/{id} {
      allow read: if isSignedIn() && (
        resource.data.get('isPublished', false) == true
        || isAdmin()
        || panitiaDitugaskanData(resource.data)
      );
      allow create: if isAdmin();
      // Slice 8.1a: DAFTAR IZIN, bukan daftar larangan. panitiaKegiatanKunciDiizinkan()
      // di atas adalah SATU-SATUNYA tempat yang menyebut field mana yang
      // boleh disentuh panitia — hasOnly() mensyaratkan affectedKeys() jadi
      // SUBSET dari daftar itu, jadi field APA PUN yang tidak disebutkan di
      // sana (baik yang sudah ada sekarang seperti nomorUrutTerakhir/
      // isPublished/isArchived/kode/panitiaUids/panitiaIzin, MAUPUN field
      // yang baru ditambahkan nanti dan lupa dipikirkan) otomatis TERTOLAK,
      // bukan otomatis diizinkan — kebalikan dari pola hasAny()/denylist
      // sebelumnya, yang "gagal terbuka" (field baru yang tidak
      // didaftarkan otomatis lolos). admin/superadmin tidak lewat cabang
      // ini sama sekali — mereka tetap boleh menulis field apa pun.
      allow update: if isAdmin() || (
        panitiaBolehSuntingData(resource.data)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(panitiaKegiatanKunciDiizinkan())
      );
      allow delete: if false;

      // kegiatan/{id}/modul/{mid}: kategori referensi | atestasi | evaluasi
      // (§2). Bank soal tidak disalin ke sini — modul evaluasi hanya
      // menyimpan rujukan (soalIds atau topikKode+jumlah), KA-6. Izin
      // panitia dibaca dari dokumen kegiatan INDUK (id), bukan dari modul
      // itu sendiri — modul tidak menyimpan panitiaUids/panitiaIzin sendiri.
      match /modul/{mid} {
        allow read: if isSignedIn();
        allow write: if isAdmin()
          || panitiaBolehSuntingData(get(/databases/$(database)/documents/kegiatan/$(id)).data);
      }
    }

    // pendaftaran/{kegiatanId}_{uid}: id deterministik (KA-3), ditulis
    // HANYA oleh server lewat Admin SDK (POST /api/pendaftaran) — nomor
    // urut dan modulSnapshot harus dijamin konsisten dalam satu transaksi,
    // dan modulSnapshot tidak boleh berubah lagi setelah dibuat (KA-5).
    // Klien tidak pernah menulis apa pun di sini, tanpa kecuali.
    match /pendaftaran/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', null) == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // attempt/{id}: id dokumen auto, ditulis HANYA oleh server lewat Admin
    // SDK (POST /api/attempt, POST /api/attempt/[id]/submit). Penilaian
    // memakai kunci_soal yang hanya bisa dibaca Admin SDK (KA-3), dan
    // jendela waktu diperiksa di server, bukan di penghitung mundur browser
    // — klien tidak pernah menulis attempt sama sekali.
    match /attempt/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', null) == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // sertifikat/{kegiatanId}_{uid}: id deterministik (KA-3), ditulis HANYA
    // oleh server lewat Admin SDK (POST /api/sertifikat/terbitkan). Serial
    // dan kodeVerifikasi tidak boleh dipalsukan atau ditimpa klien —
    // klien tidak pernah menulis sertifikat sama sekali.
    match /sertifikat/{id} {
      allow read: if isSignedIn() && (resource.data.get('uid', null) == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // parameter/global dibaca siapa pun, termasuk yang belum login — isinya
    // murni teks tampilan (nama platform, mode pendaftaran, pesan beranda).
    // PERINGATAN: dokumen ini terbuka dibaca tanpa syarat apa pun. JANGAN
    // PERNAH menaruh field sensitif (kredensial, kunci, data pribadi) di
    // sini — apa pun yang ditulis ke dokumen ini otomatis publik.
    match /parameter/global {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
